# Client Environment Variables

# reCAPTCHA Configuration (Google reCAPTCHA v2 Checkbox)
# Get your site key from: https://www.google.com/recaptcha/admin
# IMPORTANT: The site key is public and can be exposed in frontend code
REACT_APP_RECAPTCHA_SITE_KEY=your_site_key_here

# API Base URL (optional, for future use)
REACT_APP_API_URL=http://localhost:5000
